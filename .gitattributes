# Remote helper scripts are shipped to the Ubuntu GPU box and run with bash. A
# CRLF line ending makes bash fail on line 1, so these must stay LF in the repo
# regardless of the checkout platform.
*.sh text eol=lf

# Normalise the rest so diffs stay readable across machines.
*.py text
*.js text
*.mjs text
*.json text
*.md text
*.txt text
*.ps1 text eol=crlf
